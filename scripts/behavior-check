#!/bin/sh
# Run the behavior evals in evals/ with the grants they need.
#   scripts/behavior-check --tag fast            every fast case, with the no-plugin baseline
#   scripts/behavior-check CASE [CASE ...]       named cases, one runner call each (the runner keeps only the last --case)
# Extra runner flags go after --, e.g.  scripts/behavior-check team-table-status -- --keep-temp --runs 3
# It must run outside Claude Code's Bash sandbox: inside it, Bash in the eval sessions cannot start its own sandbox.
# The runner only reads evals from inside the plugin folder, but evals/ stays out of the shipped plugin (plugin/),
# so each run uses a temporary copy of plugin/ plus evals/. Results are copied back to evals/results/.
root="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
work="$(mktemp -d "${TMPDIR:-/tmp}/sf-behavior.XXXXXX")" || exit 1
cp -R "$root/plugin/." "$work/" && cp -R "$root/evals" "$work/evals" || exit 1
cd "$work" || exit 1
run() {
    claude plugin eval . --scaffold --trust-plugin --no-publish \
        --allow-tools Bash Edit Write Grep Glob CronCreate "Read(/$(pwd)/**)" \
        --runs 1 --max-cost-usd 5 --concurrency 4 "$@"
}
cases="" tag=""
while [ $# -gt 0 ]; do
    case "$1" in
        --) shift; break ;;
        --tag) tag="$2"; shift 2 ;;
        *) cases="$cases $1"; shift ;;
    esac
done
[ -n "$tag$cases" ] || { echo "usage: scripts/behavior-check --tag fast | CASE [CASE ...] [-- runner flags]" >&2; exit 2; }
status=0
if [ -n "$tag" ]; then
    run --tag "$tag" "$@" || status=1
fi
for c in $cases; do
    run --ablation none --case "$c" "$@" || status=1
done
if [ -d "$work/evals/results" ]; then
    mkdir -p "$root/evals/results" && cp -R "$work/evals/results/." "$root/evals/results/"
fi
echo "results: $root/evals/results (run folder: $work)"
exit $status
