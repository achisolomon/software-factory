#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/run-codex-agent ROLE [--mode default|routine|quality] [--model MODEL] [--project-dir DIR] [--dry-run] -- TASK

Runs one Software Factory role in Codex. The default model is selected from
reference/codex-model-routing.md. --model is an explicit override for an
available account model. --dry-run prints the resolved selection without
starting a Codex session. DIR defaults to the current directory.
EOF
}

if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
  usage
  exit 0
fi

role="$1"
shift
mode="default"
model=""
dry_run=false
has_separator=false
project_dir="$PWD"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      [[ $# -ge 2 ]] || { printf '%s\n' 'Missing value for --mode.' >&2; exit 2; }
      mode="$2"
      shift 2
      ;;
    --model)
      [[ $# -ge 2 ]] || { printf '%s\n' 'Missing value for --model.' >&2; exit 2; }
      model="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --project-dir)
      [[ $# -ge 2 ]] || { printf '%s\n' 'Missing value for --project-dir.' >&2; exit 2; }
      project_dir="$2"
      shift 2
      ;;
    --)
      has_separator=true
      shift
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

[[ "$has_separator" == true ]] || { printf '%s\n' 'Separate options from the task with --.' >&2; usage >&2; exit 2; }
task="$*"
[[ -n "$task" ]] || { printf '%s\n' 'A task is required.' >&2; usage >&2; exit 2; }

case "$role" in
  team-lead|triage-classifier|product-manager|software-architect|software-developer|test-automation-engineer|devops-engineer|finops-engineer|security-engineer|ux-ui-designer)
    ;;
  *)
    printf 'Unknown Software Factory role: %s\n' "$role" >&2
    exit 2
    ;;
esac

case "$mode" in
  default|routine|quality) ;;
  *)
    printf 'Unknown mode: %s\n' "$mode" >&2
    exit 2
    ;;
esac

if [[ -z "$model" ]]; then
  case "$mode" in
    routine)
      model="gpt-6-luna"
      ;;
    quality)
      model="gpt-6.1-sol"
      ;;
    default)
      case "$role" in
        team-lead|triage-classifier|test-automation-engineer|ux-ui-designer|finops-engineer) model="gpt-6-luna" ;;
        *) model="gpt-6.1-sol" ;;
      esac
      ;;
  esac
fi

[[ -d "$project_dir" ]] || { printf 'Project directory does not exist: %s\n' "$project_dir" >&2; exit 2; }
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
factory_root="$(cd -- "$script_dir/.." && pwd)"
project_root="$(cd -- "$project_dir" && pwd)"
agent_file="$factory_root/agents/$role.md"
contract_file="$factory_root/reference/handoff-contract.md"
routing_file="$factory_root/reference/codex-model-routing.md"

prompt="Act as the Software Factory ${role} role. Your target project is the current working directory. Read ${agent_file}, ${contract_file}, and ${routing_file} before beginning. Follow the role's ownership and approval boundaries. Read the task-cited sections of project artifacts; expand only when needed. Keep searches and tool output bounded; exclude dependency trees, generated files and nested checkouts unless in scope. After two unsuccessful routine-model attempts, return evidence for escalation rather than repeating. For web UI testing, read ${factory_root}/skills/frontend-testing/SKILL.md. The factory runner for delegating Codex specialists is ${factory_root}/scripts/run-codex-agent. Task: ${task}"

if [[ "$dry_run" == true ]]; then
  printf 'role=%s\nmode=%s\nmodel=%s\nproject_root=%s\nagent_file=%s\n' "$role" "$mode" "$model" "$project_root" "$agent_file"
  exit 0
fi

if [[ "$role" == "team-lead" ]]; then
  exec codex --cd "$project_root" --model "$model" "$prompt"
fi

exec codex exec --cd "$project_root" --skip-git-repo-check --model "$model" "$prompt"
